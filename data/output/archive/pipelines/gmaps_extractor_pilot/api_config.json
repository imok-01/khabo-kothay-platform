{
  "api_base": "https://cloud.gmapsextractor.com/api/v2",
  "auth_header": "Authorization: Bearer {{token}}",
  "content_type": "application/json",
  "rate_limit": "30 requests/minute",
  "endpoints": {
    "search": {
      "method": "POST",
      "url": "https://cloud.gmapsextractor.com/api/v2/search",
      "body": {
        "q": "query string",
        "page": 1,
        "ll": "@lat,lon,zoom",
        "hl": "en",
        "gl": "us"
      }
    },
    "reviews": {
      "method": "POST",
      "url": "https://cloud.gmapsextractor.com/api/v2/reviews",
      "body": {
        "fid": "0x89b7b0fbf994f971:0xccd1567c352422cf",
        "page": 1,
        "sort_by": 1
      }
    },
    "photos": {
      "method": "POST",
      "url": "https://cloud.gmapsextractor.com/api/v2/photos",
      "body": {
        "fid": "0x89b7b0fbf994f971:0xccd1567c352422cf",
        "page": 1
      }
    }
  }
}