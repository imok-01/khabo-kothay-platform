# Copy this file to `.env` and fill in the values you need. Every variable is
# optional — with none of them set the app runs fully offline against the
# bundled demo dataset and the keyless Leaflet/OSM map.
#
# `.env` is gitignored. Only this template is tracked.

# --- Google Maps JS API (interactive map surface) ---
# Get a key from the Google Maps Platform console, enable the Maps JS API,
# then restrict it to your domain (HTTP referrer restriction). Without a key
# the Explore map uses the fully interactive Leaflet/OSM fallback.
VITE_GOOGLE_MAPS_API_KEY=

# --- Google Places API (New) — live rating/review/hours refresh ---
# Enable the Places API in the same Google Cloud project and restrict the key
# to your domain. When unset, the live-refresh layer falls back to the Maps
# key above (both APIs can share one browser-restricted key); with neither,
# surfaces show "Google data temporarily unavailable".
VITE_GOOGLE_PLACES_API_KEY=

# --- Supabase (the live catalogue) ---
# When BOTH are set, the data repositories read the live Khabo Kothay schema
# (see src/integrations/supabase) instead of the bundled demo dataset. Leave
# unset for offline demo/preview builds. The anon key is a public client key —
# RLS must protect the tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Development OTP mock ---
# Set to "true" to show the one-time code in the UI instead of sending an SMS.
# Development only — a production build refuses to start with this enabled.
VITE_DEV_AUTH_MOCK=

# --- App environment ---
# Explicit environment marker: 'development' or 'production'. The dev-mock and
# dev-simulation safety guards read this, so a misconfigured production deploy
# fails loudly instead of leaking demo data.
VITE_APP_ENV=

# --- Dev-only internal simulation ---
# Set to "true" to layer the isolated KK Demo Restaurant (plus its demo
# customers, rewards, offers and reviews) on top of the dev environment.
# NEVER set in production — a production build with this on refuses to start
# (see src/lib/devSimulation.ts).
VITE_DEV_SIMULATION=
