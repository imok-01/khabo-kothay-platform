[TEMPLATE]
[TEMPLATE]
# Copy to .env to enable Google-powered surfaces. Without keys the app uses
# the Leaflet/OSM map fallback and shows "Google data temporarily unavailable"
# for live refreshes — the live-refresh layer falls back to the Maps
# key above (both APIs can share one browser-restricted key).
# --- Google Maps JS API (interactive map surface) ---
# Get a key from the Google Maps Platform console, enable the Maps JS API,
# then restrict it to your domain (HTTP referrer restriction).
VITE_GOOGLE_MAPS_API_KEY=
# --- Google Places API (New) — live rating/review/hours refresh ---
# Enable the Places API in the same Google Cloud project and restrict the key
# to your domain. When unset, the live-refresh layer falls back to the Maps
# key above (both APIs can share one browser-restricted key).
VITE_GOOGLE_PLACES_API_KEY=

# --- Supabase (future backend) ---
# Optional. When BOTH are set, the app's data repositories switch from the
# mock dataset to the approved Khabo Kothay Supabase schema (see
# src/integrations/supabase). Leave unset for the fully offline demo/preview
# builds. The anon key is a public client key — RLS must protect the tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Development OTP Mock ---
# Set to "true" to enable development OTP mode (displays OTP in UI for testing)
# Default: false (unset)
# NOTE: This is for development only and should never be enabled in production
VITE_DEV_AUTH_MOCK=

# --- App environment ---
# Explicit environment marker: 'development' or 'production'. The dev-mock and
# dev-simulation production-safety guards use this so a misconfigured production
# deploy fails loudly instead of leaking demo data.
VITE_APP_ENV=

# --- DEV internal simulation ---
# Set to "true" to layer the isolated KK Demo Restaurant + demo
# customers/rewards/offers/reviews on top of the existing dev environment.
# Default: false (unset). NEVER set in production — a production build with this
# on refuses to start (see src/lib/devSimulation.ts).
VITE_DEV_SIMULATION=